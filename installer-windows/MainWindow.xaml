<Window x:Class="MoreGravityInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="More Gravity Theme Installer" Height="560" Width="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Microsoft YaHei UI, Arial">

    <Border Background="#121214" 
            BorderBrush="#2c2c34" 
            BorderThickness="1" 
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- 1. Custom Titlebar -->
            <Grid Grid.Row="0" Background="#161619" MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="🎨" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="More Gravity Theme Installer" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                    <Border Background="#25252d" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                        <TextBlock Text="v1.0.0" FontSize="10.5" Foreground="#94A3B8" FontWeight="Medium"/>
                    </Border>
                </StackPanel>

                <!-- Window Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Content="─" Width="36" Height="30" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Click="BtnMinimize_Click" Cursor="Hand"/>
                    <Button Content="✕" Width="36" Height="30" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Click="BtnClose_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- 2. Hero Header -->
            <StackPanel Grid.Row="1" Margin="24,18,24,14">
                <TextBlock Text="Studio Aesthetic Theme System" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                <TextBlock Text="Ultra-lightweight 0ms tactile themes &amp; instant palette switcher for Antigravity 2.0" FontSize="12.5" Foreground="#94A3B8"/>
            </StackPanel>

            <!-- 3. Main Content Body -->
            <Grid Grid.Row="2" Margin="24,0,24,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Status Card -->
                <Border Grid.Row="0" Background="#1A1A1E" BorderBrush="#2D2D36" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Antigravity 2.0 Target:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TxtTargetPath" Text="Detecting..." FontSize="12" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Runtime Environment: " FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="TxtRuntimeEnv" Text="Standard / BetterGravity" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Status Badge -->
                        <Border Grid.Column="1" x:Name="BadgeStatus" Background="#262633" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="DotStatus" Width="8" Height="8" Fill="#F59E0B" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtStatus" Text="Checking..." FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 5 Theme Swatches Preview -->
                <Border Grid.Row="1" Background="#161619" BorderBrush="#26262E" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="INCLUDED CALIBRATED THEMES (5 STUDIO PALETTES)" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                        <UniformGrid Columns="5">
                            <!-- Everforest -->
                            <Border Background="#1C1E1B" BorderBrush="#2E382E" BorderThickness="1" CornerRadius="6" Padding="6,8" Margin="3">
                                <StackPanel HorizontalAlignment="Center">
                                    <Ellipse Width="16" Height="16" Fill="#A7C080" Margin="0,0,0,4"/>
                                    <TextBlock Text="Everforest" FontSize="10.5" FontWeight="SemiBold" Foreground="#D3C6AA" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Moss Green" FontSize="9" Foreground="#859289" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Catppuccin -->
                            <Border Background="#1E1E28" BorderBrush="#313244" BorderThickness="1" CornerRadius="6" Padding="6,8" Margin="3">
                                <StackPanel HorizontalAlignment="Center">
                                    <Ellipse Width="16" Height="16" Fill="#FAB387" Margin="0,0,0,4"/>
                                    <TextBlock Text="Catppuccin" FontSize="10.5" FontWeight="SemiBold" Foreground="#CDD6F4" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Peach Cream" FontSize="9" Foreground="#A6ADC8" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Flexoki -->
                            <Border Background="#1A1816" BorderBrush="#342D26" BorderThickness="1" CornerRadius="6" Padding="6,8" Margin="3">
                                <StackPanel HorizontalAlignment="Center">
                                    <Ellipse Width="16" Height="16" Fill="#DA702C" Margin="0,0,0,4"/>
                                    <TextBlock Text="Flexoki" FontSize="10.5" FontWeight="SemiBold" Foreground="#CECDC3" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Ochre Inky" FontSize="9" Foreground="#878580" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Kanagawa -->
                            <Border Background="#18181F" BorderBrush="#282737" BorderThickness="1" CornerRadius="6" Padding="6,8" Margin="3">
                                <StackPanel HorizontalAlignment="Center">
                                    <Ellipse Width="16" Height="16" Fill="#B6927B" Margin="0,0,0,4"/>
                                    <TextBlock Text="Kanagawa" FontSize="10.5" FontWeight="SemiBold" Foreground="#DCD7BA" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Autumn Sumi" FontSize="9" Foreground="#727169" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Melange -->
                            <Border Background="#1A1615" BorderBrush="#352522" BorderThickness="1" CornerRadius="6" Padding="6,8" Margin="3">
                                <StackPanel HorizontalAlignment="Center">
                                    <Ellipse Width="16" Height="16" Fill="#D47766" Margin="0,0,0,4"/>
                                    <TextBlock Text="Melange" FontSize="10.5" FontWeight="SemiBold" Foreground="#ECE1D7" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Peat Vermilion" FontSize="9" Foreground="#A08A83" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Actions Grid -->
                <Grid Grid.Row="2" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Big Install Button -->
                    <Button x:Name="BtnInstall" Height="48" Margin="0,0,0,10"
                            Background="#2563EB" BorderThickness="0" Cursor="Hand" Click="BtnInstall_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚀" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtBtnInstall" Text="Install More Gravity Theme" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Uninstall Button -->
                        <Button Grid.Column="0" Height="36" Background="#26262E" BorderThickness="0" Cursor="Hand" Click="BtnUninstall_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="Restore Vanilla Antigravity" FontSize="12" Foreground="#94A3B8"/>
                        </Button>

                        <!-- Launch Button -->
                        <Button Grid.Column="2" Height="36" Background="#1E293B" BorderThickness="0" Cursor="Hand" Click="BtnLaunch_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="Launch Antigravity 2.0" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8"/>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 4. Footer Bar -->
            <Border Grid.Row="3" Background="#161619" BorderBrush="#26262E" BorderThickness="0,1,0,0" Padding="18,0">
                <Grid VerticalAlignment="Center">
                    <TextBlock x:Name="TxtLog" Text="Ready. Shortcut in Antigravity: Ctrl+Alt+T or F8" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    <TextBlock Text="RedPanda Craft · MIT License" FontSize="11" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
